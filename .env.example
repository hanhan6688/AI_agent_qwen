# MinerU API Key
MINERU_API_KEY=your_mineru_api_key_here

# DashScope API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Qwen API Key (兼容旧配置，可与 DASHSCOPE_API_KEY 保持一致)
QWEN_API_KEY=your_qwen_api_key_here

# 本地模型配置 (OpenAI 兼容 API)
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1
LOCAL_MODEL_API_KEY=not-needed
LOCAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LOCAL_MODEL_PRESET=
LOCAL_MODEL_TIMEOUT=300
LOCAL_MODEL_MAX_TOKENS=4096
LOCAL_MODEL_USE_IMAGES=true

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password

# PostgreSQL配置
DB_HOST=localhost
DB_PORT=5433
DB_NAME=docextract
DB_USER=admin
DB_PASSWORD=your_db_password
